// Prisma schema for the portfolio backend (MySQL).
// After editing, run `npm run prisma:migrate` (dev) to create/apply a migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Singleton row (id always 1) holding the hero/intro section content.
model HeroContent {
  id                 Int    @id @default(1)
  name               String @default("Your Name")
  title              String @default("Software Engineer")
  subtitle           String @default("Building great things on the web and mobile.")
  summary            String @db.Text
  backgroundImageUrl String? @db.Text
}

/// Singleton row (id always 1) holding the about-me bio.
model AboutContent {
  id  Int    @id @default(1)
  bio String @db.Text
}

model Skill {
  id        Int    @id @default(autoincrement())
  name      String
  category  String @default("General")
  sortOrder Int    @default(0)
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  imageUrl    String?  @db.Text
  /// JSON-encoded string array of tech tags, e.g. ["Flutter","Dart","MySQL"]
  techTags    String   @db.Text
  liveUrl     String?  @db.Text
  repoUrl     String?  @db.Text
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model Experience {
  id          Int       @id @default(autoincrement())
  company     String
  role        String
  startDate   DateTime
  endDate     DateTime?
  description String    @db.Text
  sortOrder   Int       @default(0)
}

model Education {
  id        Int       @id @default(autoincrement())
  school    String
  degree    String
  startDate DateTime
  endDate   DateTime?
  sortOrder Int       @default(0)
}

model SocialLink {
  id       Int    @id @default(autoincrement())
  platform String @unique
  url      String @db.Text
}

/// Only the most recently uploaded row is treated as "current" (highest id / uploadedAt).
model ResumeFile {
  id         Int      @id @default(autoincrement())
  filename   String
  url        String   @db.Text
  uploadedAt DateTime @default(now())
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String   @db.Text
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)
}
