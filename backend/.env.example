# Copy this file to .env and fill in real values. Never commit .env.

# MySQL connection string used by Prisma.
# Local dev (docker-compose, mapped to host port 3307 to avoid clashing with
# a native MySQL install on 3306): mysql://portfolio:portfolio@localhost:3307/portfolio
# VPS prod: mysql://<user>:<password>@localhost:3306/portfolio
DATABASE_URL="mysql://portfolio:portfolio@localhost:3307/portfolio"

# Port the Node API listens on.
PORT=3000

# Secret used to sign admin JWTs. Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-string"

# JWT expiry, e.g. "12h", "7d"
JWT_EXPIRES_IN="12h"

# Seed admin login (used only by `npm run seed`, to create the first/only admin user).
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-immediately"

# Comma-separated list of origins allowed to call the API with credentials.
# In prod (same-origin via Nginx) this can just be your domain; useful for local dev too.
CORS_ORIGINS="http://localhost:5000,https://yourdomain.com"

# Public base URL the API is served from, used to build absolute file URLs (images, resume).
# Local dev: http://localhost:3000
# Prod: https://yourdomain.com  (Nginx proxies /api and /uploads under the same origin)
PUBLIC_BASE_URL="http://localhost:3000"
